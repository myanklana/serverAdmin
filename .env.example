# Copy to .env (or run ./scripts/setup.sh, which does it for you with a random password).
POSTGRES_PASSWORD=change-me
APP_PORT=8080
# Origins allowed to call the API from a browser (comma separated).
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
# The first account is always allowed. Set to true to let anyone sign up afterwards.
APP_REGISTRATION_OPEN=false
APP_METRICS_RETENTION_DAYS=30
